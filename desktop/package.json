{
  "name": "tank-duel-desktop",
  "version": "1.0.0",
  "description": "Tank Duel - online artillery game",
  "author": "Tank Duel",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node copy-public.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tankduel.game",
    "productName": "Tank Duel",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "TankDuel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
